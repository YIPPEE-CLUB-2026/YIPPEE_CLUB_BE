# Names only. Real values belong in the server's secret store (for example AWS Parameter Store),
# never in this file or in Git.

# At least 32 bytes of random text. Signs access tokens and every stored digest.
SECRET_KEY=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=yippee_club_db
MYSQL_USER=
MYSQL_PASSWORD=
# Database connections per server instance. Keep (instances x this) under MySQL's max_connections.
DB_POOL_SIZE=20

# Behind a load balancer or the Caddy proxy (deploy/Caddyfile): native. On a laptop: none.
FORWARD_HEADERS_STRATEGY=none

# The Swagger page at /swagger-ui/index.html. It lists every address, the admin ones included:
# true on a development server only.
SWAGGER_ENABLED=false

# Frontend origins allowed to call this API from a browser, comma-separated.
CORS_ALLOWED_ORIGINS=https://www.yippeclub.com,https://yippeclub.com,http://localhost:3000

# Mail goes out over SMTP. With Resend: this host and port, the user name "resend", the Resend
# API key as the password, and a From address on a domain verified at Resend.
# For the implicit-TLS port 465 set EMAIL_USE_SSL=true and EMAIL_USE_TLS=false.
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=

# Keys that must be true in the signup "agreements" object, comma-separated (for example terms,privacy).
# Empty: no consent is checked.
REQUIRED_AGREEMENTS=

# The fixed https page of the frontend that takes a reset token. Empty: reset requests answer 500.
PASSWORD_RESET_FRONTEND_URL=https://www.yippeclub.com/password/reset

# Where activity files are kept on this server. Must be a disk that survives a redeploy.
ACTIVITY_PRIVATE_ROOT=private_uploads

# Toss Payments secret key (test_sk... or live_sk...). Empty: paid orders are refused, free ones work.
TOSS_SECRET_KEY=

# Years a withdrawn buyer's e-mail, name and phone are kept beside the trade records, then destroyed.
TRADE_RECORD_YEARS=5

# Sign-in through a provider. Each is off (its address answers 404) until its client id is set.
# Kakao: the REST API key and, when the console has it turned on, the client secret.
# Each provider's console must list the frontend's redirect address.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Emails of the accounts that may register activities and set prices, comma-separated.
# An address listed here cannot sign in through a provider, only with its password.
ADMIN_EMAILS=
